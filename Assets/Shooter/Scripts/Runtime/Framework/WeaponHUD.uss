.hud-control > .icon-BotaoAudio,
.hud-control > .icon-BotaoMicrofone,
.hud-control > .icon-BotaoChat,
.hud-control > .icon-BotaoMarcar,
.hud-control > .icon-BotaoAjustes,
.hud-control > .icon-BotaoEmotes,
.hud-control > .icon-BotaoCamera,
.hud-control > .icon-BotaoInteragir {
    width: 50%;
    height: 50%;
}
.touch-look-surface {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.touch-only-control {
    display: none;
}
.touch-enabled .touch-only-control {
    display: flex;
}
.hud-control--unavailable {
    opacity: 0.45;
}
.hud-control.hud-control--pressed {
    background-color: rgba(94, 76, 26, 0.95);
    border-color: rgb(246, 197, 66);
}
#move-indicator > VisualElement {
    position: absolute;
    left: 33px;
    top: 33px;
}

/* Mobile finish: position follows the approved layout; controls stay visually quiet. */
.hud-panel, .hud-weapon-slot {
    background-color: rgba(10, 17, 22, 0.76);
    border-color: rgba(163, 188, 197, 0.30);
}
#weapon-info-container {
    background-color: rgba(16, 23, 28, 0.84);
    border-color: rgba(246, 197, 66, 0.78);
    border-left-width: 3px;
}
.hud-control {
    background-color: rgba(9, 16, 21, 0.43);
    border-color: rgba(222, 234, 235, 0.53);
    border-width: 1px;
}
.hud-control--accent {
    background-color: rgba(76, 56, 12, 0.64);
    border-color: rgb(246, 197, 66);
}
.hud-control--accent .hud-icon {
    -unity-background-image-tint-color: rgb(246, 197, 66);
}
.hud-control-caption {
    font-size: 8px;
    letter-spacing: 0.3px;
    color: rgb(231, 239, 241);
}
.hud-control--unavailable {
    opacity: 0.32;
}
.hud-control.hud-control--pressed,
#run.hud-control--active {
    background-color: rgba(99, 77, 20, 0.78);
    border-color: rgb(246, 197, 66);
}
#run.hud-control--active .hud-icon,
#run.hud-control--active .hud-control-caption {
    -unity-background-image-tint-color: rgb(246, 197, 66);
    color: rgb(246, 197, 66);
}
/* The full-screen drag surface must never acquire a pressed-button fill. */
.touch-look-surface,
.touch-look-surface.hud-control--pressed {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
#move-indicator {
    background-image: none;
    background-color: rgba(12, 22, 30, 0.24);
    border-radius: 56px;
    border-width: 1px;
    border-color: rgba(219, 234, 238, 0.27);
}
#move-indicator > VisualElement {
    background-image: none;
    background-color: rgba(222, 235, 238, 0.22);
    border-radius: 23px;
    border-width: 1px;
    border-color: rgba(235, 244, 246, 0.68);
}
/* Override native progress-bar internals too: their default 16px frame caused overlap. */
#player-ammo-bar .unity-progress-bar,
#player-ammo-bar .unity-progress-bar__container,
#player-ammo-bar .unity-progress-bar__background,
#player-ammo-bar .unity-progress-bar__progress {
    height: 3px;
    min-height: 3px;
    max-height: 3px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
}
#player-ammo-bar .unity-progress-bar__background {
    background-color: rgba(243, 232, 203, 0.12);
}
#player-health-bar,
#player-health-bar .unity-progress-bar,
#player-health-bar .unity-progress-bar__container,
#player-health-bar .unity-progress-bar__background,
#player-health-bar .unity-progress-bar__progress {
    height: 6px;
    min-height: 6px;
    max-height: 6px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 3px;
}
#player-stamina-bar {
    margin-top: 4px;
}
#player-stamina-bar,
#player-stamina-bar .unity-progress-bar,
#player-stamina-bar .unity-progress-bar__container,
#player-stamina-bar .unity-progress-bar__background,
#player-stamina-bar .unity-progress-bar__progress {
    height: 3px;
    min-height: 3px;
    max-height: 3px;
    padding: 0;
    border-width: 0;
    border-radius: 2px;
}
#player-stamina-bar .unity-progress-bar__progress {
    background-color: rgb(79, 191, 213);
}
.hud-health-caption {
    font-size: 10px;
    margin-bottom: 5px;
}
.backpack-panel {
    background-color: rgba(11, 19, 25, 0.97);
    border-right-color: rgba(246, 197, 66, 0.78);
}
.backpack-weapon, .backpack-tab, .backpack-close {
    background-color: rgb(19, 31, 40);
    border-color: rgb(52, 73, 84);
}
.backpack-weapon--active {
    background-color: rgb(35, 36, 29);
    border-color: rgb(246, 197, 66);
}

/* Minimal field interface: one accent and only the implemented actions. */
.hud-control--unavailable {
    display: none;
}
.hud-control {
    background-color: rgba(11, 16, 20, 0.18);
    border-color: rgba(238, 242, 232, 0.34);
}
.hud-control .hud-icon {
    -unity-background-image-tint-color: rgb(238, 242, 232);
}
.hud-control-caption {
    display: none;
}
#run.hud-control--active .hud-control-caption {
    display: flex;
    font-size: 8px;
    color: rgb(200, 246, 107);
}
.hud-control.hud-control--pressed,
#run.hud-control--active {
    background-color: rgba(200, 246, 107, 0.18);
    border-color: rgb(200, 246, 107);
}
#run.hud-control--active .hud-icon {
    -unity-background-image-tint-color: rgb(200, 246, 107);
}
#fire {
    background-color: rgba(200, 246, 107, 0.08);
    border-color: rgba(200, 246, 107, 0.82);
}
#fire .hud-icon {
    -unity-background-image-tint-color: rgb(200, 246, 107);
}
#weapon-info-container {
    background-color: rgba(11, 16, 20, 0.22);
    border-width: 0;
}
#weapon-type-label {
    color: rgb(180, 190, 183);
    font-size: 9px;
    letter-spacing: 1px;
}
#ammo-label {
    color: rgb(238, 242, 232);
}
.hud-reload-caption {
    display: none;
}
#player-ammo-bar .unity-progress-bar__progress {
    background-color: rgb(200, 246, 107);
}
.hud-weapon-slot {
    border-width: 0;
    background-color: rgba(11, 16, 20, 0.20);
}
.hud-weapon-slot Label {
    display: none;
}
.hud-weapon-slot .hud-icon {
    -unity-background-image-tint-color: rgb(238, 242, 232);
}
.hud-map-caption {
    display: none;
}
#map-frame {
    width: 104px;
    height: 104px;
    border-color: rgba(238, 242, 232, 0.12);
    background-color: rgba(11, 16, 20, 0.38);
}
#move-indicator {
    background-color: rgba(11, 16, 20, 0.10);
    border-color: rgba(238, 242, 232, 0.18);
}
#move-indicator > VisualElement {
    background-color: rgba(238, 242, 232, 0.18);
    border-color: rgba(238, 242, 232, 0.65);
}
#player-health-bar .unity-progress-bar__progress {
    background-color: rgb(200, 246, 107);
}
#player-stamina-bar .unity-progress-bar__progress {
    background-color: rgba(238, 242, 232, 0.62);
}
.backpack-panel {
    background-color: rgba(11, 16, 20, 0.97);
    border-right-color: rgba(200, 246, 107, 0.65);
}
.backpack-weapon--active {
    background-color: rgb(25, 33, 23);
    border-color: rgb(200, 246, 107);
}
