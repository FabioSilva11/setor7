#hud-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

#weapon-info-container,
#health-info-container {
    position: absolute;
    bottom: 20px;
    background-color: rgba(0, 0, 0, 0.0);
    padding: 15px;
    border-radius: 5px;
    width: 320px;
}

#weapon-info-container {
    right: 20px;
    left: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end; /* Align children to the right */
}

#health-info-container {
    left: 20px;
    right: auto;
}

#player-health-bar {
    width: 100%;
    height: 30px;
    min-height: 30px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    flex-shrink: 0;
    justify-content: center;
}

#player-stamina-bar {
    width: 100%;
    height: 30px;
    min-height: 30px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    flex-shrink: 0;
    justify-content: center;
}

#player-ammo-bar {
    width: 85%;
    height: 30px;
    min-height: 30px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    flex-shrink: 0;
    justify-content: center;
}

#ammo-container {
    display: flex;
    flex-direction: row;
    align-items: center; /* Vertically center items */
    justify-content: flex-end; /* Push everything to the right */
    margin-top: 5px;
    width: 100%;
}

#ammo-label {
    font-size: 16px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgb(0, 0, 0);
    margin-right: 10px; /* Space between label and bar */
    flex-shrink: 0; /* Prevent text from shrinking */
}

#weapon-type-label {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgb(0, 0, 0);
    margin-bottom: 5px;
}

#weapon-icon {
    align-self: flex-end;
}

#reticle-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

#player-reticle {
    position: relative;
    width: 256px;
    height: 256px;
    -unity-background-scale-mode: scale-to-fit;
    background-size: 100% 100%;
    transform-origin: center;
}

/* Notification Container */
.notification-container {
    position: absolute;
    top: 20px;
    right: 20px;
    flex-direction: column;
    min-width: 200px;
    max-width: 350px;
    max-height: 200px;
}

.notification-item {
    flex-direction: column;
    background-color: rgba(22, 22, 24, 0.9);
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 6px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.notification-item Label {
    color: rgb(229, 229, 229);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.notification-fade-out {
    opacity: 0;
}

/* Low ammo warning style */
.low-ammo {
    color: rgb(255, 100, 0);
}

/* No ammo style */
.no-ammo {
    color: rgb(255, 0, 0);
}

#message-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

#message-label {
    font-size: 28px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 0px 0px 10px rgba(0, 0, 0, 0.5);
    margin-bottom: 12px;
}

#countdown-label {
    font-size: 150px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    letter-spacing: -5px;
}

#message-divider {
    width: 194px;
    height: 4px;
    background-color: white;
    margin-bottom: -10px;
    align-self: center;
}

:root{
    --color-progressbar-background: rgba(16, 16, 16, 0.75);
    --color-progressbar-border-color: rgba(0, 0, 0, 0);
    --color-progressbar-fill: rgba(145, 213, 97, 0.75);
    --color-progressbar-text: rgb(255, 255, 255);
    --color-progressbar-text-low: rgb(255, 0, 0);
    --color-progressbar-ammo-blue: rgba(19, 181, 231, 0.75);
}

/* Setor 07 shooter presentation. Gameplay data keeps the template's existing bindings. */
#shooter-hud, #backpack-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.hud-panel {
    background-color: rgba(16, 24, 26, 0.91);
    border-width: 1px;
    border-color: rgb(77, 96, 99);
}
#map-frame {
    position: absolute;
    left: 32px;
    top: 26px;
    width: 142px;
    height: 128px;
    overflow: hidden;
}
.hud-map {
    flex-grow: 1;
    opacity: 0.35;
    background-size: contain;
}
.hud-map-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    color: rgb(212, 218, 218);
    font-size: 9px;
    -unity-text-align: middle-center;
}
#weapon-stack {
    position: absolute;
    top: 26px;
    right: 32px;
    width: 266px;
}
#weapon-info-container {
    position: relative;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
    width: 266px;
    height: 90px;
    padding: 0;
    align-items: flex-start;
    background-color: rgba(50, 42, 22, 0.95);
    border-color: rgb(246, 197, 66);
    border-radius: 0;
}
#weapon-type-label {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 7px;
    height: 17px;
    min-height: 17px;
    flex-shrink: 0;
    margin: 0;
    max-width: 225px;
    font-size: 11px;
    color: rgb(246, 197, 66);
    -unity-font-style: bold;
    text-overflow: ellipsis;
    overflow: hidden;
}
#weapon-icon {
    position: absolute;
    right: 13px;
    top: 28px;
    width: 108px;
    height: 39px;
}
#ammo-label {
    position: absolute;
    left: 12px;
    top: 26px;
    width: 130px;
    height: 34px;
    margin: 0;
    font-size: 26px;
}
.hud-reload-caption {
    position: absolute;
    left: 12px;
    bottom: 9px;
    height: 12px;
    color: rgb(180, 188, 188);
    margin: 0;
    font-size: 9px;
}
#player-ammo-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: auto;
    height: 3px;
    min-height: 3px;
}
#player-ammo-bar .unity-progress-bar__title {
    display: none;
}
#player-ammo-bar .unity-progress-bar__progress {
    background-color: rgb(246, 197, 66);
}
.hud-weapon-slots {
    flex-direction: row;
    margin-top: 6px;
}
.hud-weapon-slot {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 52px;
    margin-right: 3px;
    padding: 3px;
    align-items: center;
    justify-content: center;
    background-color: rgba(16, 24, 26, 0.91);
    border-width: 1px;
    border-color: rgb(68, 86, 92);
}
.hud-weapon-slot Label {
    color: rgb(186, 199, 199);
    font-size: 10px;
    -unity-font-style: bold;
}
.hud-weapon-slot--accent {
    border-color: rgb(246, 197, 66);
}
.hud-weapon-slot .hud-icon {
    width: 65%;
    height: 24px;
}
#health-info-container {
    left: 50%;
    right: auto;
    bottom: 33px;
    width: 278px;
    margin-left: -139px;
    padding: 0;
}
.hud-health-caption {
    color: white;
    margin: 0;
    font-size: 12px;
    -unity-font-style: bold;
}
#player-health-bar {
    height: 15px;
    min-height: 15px;
}
#player-stamina-bar {
    height: 5px;
    min-height: 5px;
}
#player-stamina-bar .unity-progress-bar__title {
    display: none;
}
.notification-container {
    top: 72px;
    right: 50%;
    margin-right: -175px;
    width: 350px;
}
#move-indicator {
    position: absolute;
    left: 37px;
    bottom: 56px;
    width: 112px;
    height: 112px;
    align-items: center;
    justify-content: center;
    background-size: contain;
}
#move-indicator > VisualElement {
    width: 46px;
    height: 46px;
    background-size: contain;
}
.hud-control {
    position: absolute;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border-width: 1px;
    border-color: rgb(128, 146, 143);
    background-color: rgba(16, 24, 26, 0.78);
}
.hud-control--accent {
    border-color: rgb(246, 197, 66);
    background-color: rgba(68, 54, 23, 0.92);
}
.hud-icon {
    width: 50%;
    height: 50%;
    background-size: contain;
}
.hud-control-caption {
    position: absolute;
    bottom: -13px;
    left: -16px;
    right: -16px;
    margin: 0;
    color: white;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
#backpack-overlay {
    display: none;
}
.backpack-panel {
    height: 100%;
    width: 64%;
    max-width: 816px;
    padding: 24px 26px;
    background-color: rgba(16, 22, 25, 0.96);
    border-right-width: 1px;
    border-right-color: rgb(246, 197, 66);
}
.backpack-header {
    flex-direction: row;
    align-items: center;
    min-height: 51px;
    padding-bottom: 10px;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(68, 86, 92);
}
.backpack-title {
    color: white;
    font-size: 26px;
    -unity-font-style: bold;
    flex-grow: 1;
}
.backpack-capacity {
    color: rgb(246, 197, 66);
    font-size: 12px;
    margin-right: 12px;
}
.backpack-close {
    min-width: 42px;
    height: 42px;
    font-size: 24px;
    color: white;
    background-color: rgb(19, 31, 36);
}
.backpack-content {
    flex-direction: row;
    flex-grow: 1;
}
.backpack-equipment {
    width: 52%;
    padding-right: 14px;
}
.backpack-inventory {
    width: 48%;
}
.backpack-heading {
    color: rgb(232, 235, 230);
    font-size: 12px;
    -unity-font-style: bold;
}
.backpack-gear, .backpack-tabs {
    flex-direction: row;
    margin: 5px 0;
}
.backpack-weapon {
    min-height: 59px;
    margin-top: 6px;
    padding: 7px 10px;
    color: white;
    border-width: 1px;
    border-color: rgb(68, 86, 92);
    background-color: rgb(19, 31, 36);
}
.backpack-weapon--active {
    border-color: rgb(246, 197, 66);
    background-color: rgb(49, 41, 22);
}
#backpack-weapon-icon {
    height: 66px;
    margin: 4px 0;
}
#backpack-weapon-name, #backpack-weapon-ammo {
    color: white;
    -unity-font-style: bold;
}
.backpack-tab {
    flex-grow: 1;
    min-height: 34px;
    margin: 0 3px 0 0;
    color: rgb(193, 204, 205);
    background-color: rgb(19, 31, 36);
    border-color: rgb(68, 86, 92);
    -unity-font-style: bold;
}
.backpack-tab--selected {
    color: rgb(246, 197, 66);
    border-color: rgb(246, 197, 66);
}
.backpack-empty {
    color: rgb(165, 184, 190);
    margin-top: 9px;
    white-space: normal;
}
